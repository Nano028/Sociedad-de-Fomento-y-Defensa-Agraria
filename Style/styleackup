

/* ACERCA MOBILE FIRST */
























































/* NOVEDADES */
.bodyNovedades {
    .seccionProyectosNovedades { 
        .noticiaContenedor {
            .noticiaCard {
                .noticiaContenido {
                    border-radius: 10px;
                    background-color: rgb(33, 46, 41);
                    padding: 10px;
                    margin-bottom: 50px;
                    text-align: center;
                    .noticiaTitulo {
                        text-align: center;
                        margin-top: 15px; 
                        margin-bottom: 50px;
                    }
                    .noticiaImagenPrincipal,
                    .noticiaGaleria {
                        width: 80%;
                        margin-top: 15px; 
                        margin-bottom: 50px;
                    }
                    .noticiaParrafo {
                        text-align: justify;
                    }
                }
            }
        }
    }
    .informacionInteres {
        .seccionSitios {
            .sitiosInteres{
                .botonSitioInteres {
                    margin-top: 10px;
                    margin-bottom: 10px;
                    padding: 10px;

                }
            }
        }
    }
}










/* ACERCA */

.bodyHistoria {
    .historia {
        margin-bottom: 20px;
    }
  
    .sectorPresidentes {
        background-color: rgba(126,168,152,0.5);
        .filaPresidentes {
            margin-top: 20px;
            margin-bottom: 20px;
        }
    }
    .sectorImagenesDestacadas {
        .imagenesDestacadasColumna {
            align-content: center;
            text-align: center;
            .imagenDestacada {
                margin-top: 10px;
                margin-bottom: 10px;
                width: 30vw;
            }
        }
    }
    .sectorDocumentosHistoricos {
        background-color: rgba(126,168,152,1);
        border-radius: 10px;
        padding-bottom: 20px;
justify-content: space-around;
        .cardDocumentoHistorico {
            .imagenDocumentoHistorico {
                text-align: center;
                padding: 20px;
            }
            .linkDocumentoHistorico {
                text-align: center;
                text-decoration: none;
                font-size: 20px;
            }
        }
    }
}
.bodyAlmacen {
    .almacenFilaProductos {
        padding: 20px;
        .listaProductos {
            list-style-type: none;
            .listaItems {
                margin-top: 20px;
                margin-bottom: 20px;
                font-weight: 800;
            }
        }
    }
    #listaProductosDos {            
        background-color: rgba(126,168,152,1);
    }
.almacenFilaTres {
    margin: 15px;
    justify-content: space-around;
    .fotoAdministracionRow {
        .fotoAdministracionGalpon {
            height: 20vw;         
            width:  auto;
    }}
}

}

@media screen and (min-width: 1500px ) {
    
    .bodyAlmacen,
    .bodyHistoria,
    .bodyAcerca,
    .bodyNovedades,
    .bodyIndex {
        background-color: rgb(240, 240, 240);
        padding-left: 15px;
        padding-right: 15px;
