            text-align: center;
        }
    }
    
    .contacto {
        text-align: center  ;
        align-content: center;
        .contactoLogo {
            width: 20%; 
        }
    }
    
    .noticiaCometido {
        justify-content: space-around;
    }
    
    
    /* ACERCA */
    .bodyAcerca {
